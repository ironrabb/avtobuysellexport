<!doctype html>
<html lang="uz">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title><link rel="stylesheet" href="/public/css/main.css"><link rel="stylesheet" href="/public/css/car-manage.css">
</head>
<body>
  <header class="topbar"><a class="brand" href="/admin/cars">Avto<span>.uz</span> <small>Admin</small></a><form method="post" action="/admin/logout"><button class="logout" type="submit">Chiqish</button></form></header>
  <main class="container">
    <div class="page-heading"><div><p class="eyebrow">BOSHQARUV PANELI</p><h1>Ko‘rib chiqilayotgan e’lonlar</h1></div><span class="count"><%= cars.length %> ta</span></div>
    <% if (!cars.length) { %><section class="empty-state"><h2>Yangi e’lon yo‘q</h2><p>Tekshirish uchun yuborilgan avtomobillar shu yerda ko‘rinadi.</p></section><% } %>
    <section class="car-list">
      <% cars.forEach((car) => { %>
        <article class="car-card">
          <div class="car-image"><% if (car.images && car.images.length) { %><img src="/public<%= car.images[0] %>" alt="<%= car.title %>"><% } else { %><span>Rasm mavjud emas</span><% } %></div>
          <div class="car-info"><p class="eyebrow"><%= car.make %> · <%= car.year %></p><h2><%= car.title %></h2><p><%= car.region %> · <%= Number(car.mileage).toLocaleString('uz-UZ') %> km</p><strong><%= Number(car.price).toLocaleString('uz-UZ') %> so‘m</strong><% if (car.sellerId) { %><p class="seller">Sotuvchi: <%= car.sellerId.name %> (<%= car.sellerId.phone %>)</p><% } %></div>
          <div class="actions"><form method="post" action="/admin/cars/<%= car._id %>/moderate"><input type="hidden" name="action" value="approve"><button class="approve" type="submit">Tasdiqlash</button></form><form method="post" action="/admin/cars/<%= car._id %>/moderate"><input type="hidden" name="action" value="reject"><button class="reject" type="submit">Rad etish</button></form></div>
        </article>
      <% }); %>
    </section>
  </main>
</body>
</html>
